# Server & Environment
NODE_ENV=development
PORT=3000

# Database Configuration
# Default is SQLite for self-contained, zero-configuration local development:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production deployment:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/easyway?schema=public"

# Authentication & Security
JWT_SECRET=easyway_super_secure_jwt_secret_key_tourism_india_2026_discover
JWT_EXPIRES_IN=7d

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000

# GEMINI_API_KEY: Injected by AI Studio if using Gemini
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

